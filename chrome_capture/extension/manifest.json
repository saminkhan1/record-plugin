{
  "manifest_version": 3,
  "name": "Record Chrome Provider",
  "version": "0.2.3",
  "key": "",
  "description": "Capture active Chrome workflow actions into a local Record workflow for review.",
  "icons": {
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "webNavigation", "scripting", "downloads", "alarms", "storage", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/url-sanitizer.js", "src/causality.js", "src/user-events.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Record Chrome Provider",
    "default_icon": {
      "128": "icons/icon128.png"
    },
    "default_popup": "src/popup.html"
  }
}
